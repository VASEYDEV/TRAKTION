// Shared by the app and UI test targets. Simulator CI overrides signing only
// for that invocation; device builds retain Xcode's normal signing behavior.
SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
TRAKTION_BUNDLE_IDENTIFIER = dev.vasey.traktion
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_STRICT_CONCURRENCY = complete
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// Optional, ignored by git. Set DEVELOPMENT_TEAM and, if needed, a registered
// TRAKTION_BUNDLE_IDENTIFIER here. Never place credentials in an xcconfig.
#include? "Signing.local.xcconfig"
